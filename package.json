{
  "name": "animerch",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack ecommerce demo with React, Bun/Hono, MongoDB, Redis and PayPal",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "server": "bun --watch server/server.ts",
    "admin:create": "bun server/scripts/create-admin.ts",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "cd server && bun test",
    "test:server": "cd server && bun test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@paypal/react-paypal-js": "^10.6.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@reduxjs/toolkit": "^2.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "axios": "^1.20.0",
    "dompurify": "^3.4.17",
    "easy-magnify": "^1.2.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "swiper": "^14.3.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
